# Shopact Environment Configuration

# Database Configuration (PostgreSQL / Neon / Supabase / Vercel Postgres)
# Pooled connection string for serverless runtime
DATABASE_URL="postgresql://user:password@host:5432/shopact?pgbouncer=true&connection_limit=1"
# Direct connection string for Prisma CLI / migrations (optional for pooled providers)
DIRECT_URL="postgresql://user:password@host:5432/shopact"

# Meta WhatsApp Cloud API Configuration
WHATSAPP_TOKEN="EAA..."
WHATSAPP_VERIFY_TOKEN="your_custom_verify_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
APP_SECRET="your_meta_app_secret_for_webhook_signature_verification"

# Session & Security
SESSION_SECRET="generate_a_random_32_character_hex_secret_here"

# Gemini Free Tier (Reserved for future AI features)
GEMINI_API_KEY=""
